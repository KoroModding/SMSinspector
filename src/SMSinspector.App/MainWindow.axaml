<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMSinspector.App.ViewModels"
        x:Class="SMSinspector.App.MainWindow"
        x:DataType="vm:DiagnosticViewModel"
        Title="SMSinspector"
        Width="900" Height="500"
        FontFeatures="-calt">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="Connection" FontSize="20" FontWeight="SemiBold" />

    <StackPanel Orientation="Horizontal" Spacing="10">
      <Ellipse Width="12" Height="12" VerticalAlignment="Center"
               Fill="#C0392B"
               IsVisible="{Binding !IsConnected}" />
      <Ellipse Width="12" Height="12" VerticalAlignment="Center"
               Fill="#27AE60"
               IsVisible="{Binding IsConnected}" />
      <SelectableTextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
    </StackPanel>

    <SelectableTextBlock Text="{Binding Details}"
                         FontFamily="Consolas, Menlo, monospace"
                         IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel Spacing="6" IsVisible="{Binding IsConnected}">
      <TextBlock Text="MEM1 header, read through the game address space" Opacity="0.7" />
      <SelectableTextBlock Text="{Binding HeaderDump}" FontFamily="Consolas, Menlo, monospace" />
    </StackPanel>
  </StackPanel>
</Window>
